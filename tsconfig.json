{
  "compilerOptions": {
    "target": "ES6",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "build",

    "module": "CommonJS",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "types": ["@types/jest", "@types/node"],
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,

    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["./src/**/*.test.ts"]
}
